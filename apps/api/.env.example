# Copy to .env and fill in your key (do not commit .env)
DEEPSEEK_API_KEY=
# Optional override (default: deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash
# Free AI calls per device per day (summary + translate share the same pool)
# FREE_AI_DAILY_LIMIT=3
# Optional Netscape cookies for Bilibili CC/AI captions (or place apps/api/cookies.txt)
# YTDLP_COOKIES_FILE=D:/path/to/cookies.txt
